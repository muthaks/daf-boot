# Rendered by the nginx image's envsubst at container start
# (/etc/nginx/templates -> /etc/nginx/conf.d). Variable from env.properties:
#   DAF_API_URL  absolute prefix of the DAF (approvalforum) API as the browser reaches it, i.e. the
#                API gateway's /daf route, which maps to <daf server>/approvalforum/api.
#                The remote addresses /auth/... and /approvalForum/agenda/... under it.
# Served to the browser as assets/config.json.
server {
    listen 80;
    server_name localhost;

    # Runtime configuration (the remote reads it relative to its own bundle).
    location = /assets/config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"apiUrl":"${DAF_API_URL}"}';
    }

    # The shell must always see the current remoteEntry.json.
    location = /remoteEntry.json {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
    }

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
