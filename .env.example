# Docker Compose variables (copy to .env; .env is gitignored). Same shape as the other platform stacks.
# Image tag deployed by latest.sh — a TeamCity build number (Daf Boot), or latest.
BUILD_NUMBER=latest
DOCKER_REGISTRY=crsk-docker-private.rmb.co.za
# DNS server the containers use (the server's resolver; the deploy tool fills it from /etc/resolv.conf if left empty)
DNS_SERVER=
# Pinned bridge subnet for this stack (allocation table in cat-utils docs/DEPLOYMENT.md)
DOCKER_SUBNET=172.31.100.96/29
