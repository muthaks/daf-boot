// LOCAL INTERNATIONAL RULES - DO NOT CHANGE THE ORDER IN WHICH THEY APPEAR BELOW UNLESS THE RANKING CHANGES
// ---------------------------------------------------------------------------------------------------------

rule "LocalInternationalSubs"
agenda-group "LocalInternationalRG"
activation-group "LocalInternationalSubsAG"
salience 99999
    when
        $data: ApprovalForumData((isRiskTakerGroupCode(ApprovalForumMetadata.BOTSWANA) || isRiskTakerGroupCode(ApprovalForumMetadata.NAMIBIA) ||
                    isRiskTakerGroupCode(ApprovalForumMetadata.ZAMBIA) || isRiskTakerGroupCode(ApprovalForumMetadata.NIGERIA) ||
                    isRiskTakerGroupCode(ApprovalForumMetadata.GHANA) || isRiskTakerGroupCode(ApprovalForumMetadata.MOZAMBIQUE) ||
                    isRiskTakerGroupCode(ApprovalForumMetadata.TANZANIA) || isRiskTakerGroupCode(ApprovalForumMetadata.MAURITIUS)) &&
                    (isAnnualReview() || (!isAnnualReview() &&
                    (isFacilityMovementChanged(ApprovalForumMetadata.BOTSWANA) || isFacilityMovementChanged(ApprovalForumMetadata.NAMIBIA) ||
                                        isFacilityMovementChanged(ApprovalForumMetadata.ZAMBIA) || isFacilityMovementChanged(ApprovalForumMetadata.NIGERIA) ||
                                        isFacilityMovementChanged(ApprovalForumMetadata.GHANA) || isFacilityMovementChanged(ApprovalForumMetadata.MOZAMBIQUE) ||
                                        isFacilityMovementChanged(ApprovalForumMetadata.TANZANIA) || isFacilityMovementChanged(ApprovalForumMetadata.MAURITIUS)))))
    then
        $data.addTotalNumberOfApprovalsRequiredToAll(1);
        $data.popListModelToHighestRank("ROA Approval List", 1, 1); //min max
        $data.setRuleExecuted(true);
        displayRuleTriggered(drools);
end

rule "LocalInternationalIndia"
agenda-group "LocalInternationalRG"
activation-group "LocalInternationalIndiaAG"
salience 99999
    when
        $data: ApprovalForumData(isRiskTakerGroupCode(ApprovalForumMetadata.INDIA) && (isAnnualReview() || (!isAnnualReview() && isFacilityMovementChanged(ApprovalForumMetadata.INDIA))))
    then
        $data.addTotalNumberOfApprovalsRequiredToAll(1);
        $data.popListModelToHighestRank("India Approval List", 1, 1); //min max
        $data.setRuleExecuted(true);
        displayRuleTriggered(drools);
end

rule "LocalInternationalLondon"
agenda-group "LocalInternationalRG"
activation-group "LocalInternationalLondonAG"
salience 99999
    when
        $data: ApprovalForumData(isRiskTakerGroupCode(ApprovalForumMetadata.LONDON) && (isAnnualReview() || (!isAnnualReview() && isFacilityMovementChanged(ApprovalForumMetadata.LONDON))))
    then
        $data.addTotalNumberOfApprovalsRequiredToAll(1);
        $data.popListModelToHighestRank("London Approval List", 1, 1); //min max
        $data.setRuleExecuted(true);
        displayRuleTriggered(drools);
end

