    end

        rule "MeetingTypeFinancialInstitutionDmType1FinAmRf"
        agenda-group "MeetingTypeFinancialInstitutionDmType1FinRG"
        activation-group "MeetingTypeFinancialInstitutionDmType1FinAG"
        salience 9999
            when
                $data: ApprovalForumData("Asset Management Companies".equalsIgnoreCase(fit) ||
                                         "Unit Trust Management Companies".equalsIgnoreCase(fit) ||
                                         "Unit Trust Funds".equalsIgnoreCase(fit) ||
                                         "Pension Funds".equalsIgnoreCase(fit) ||
                                         "Provident Funds".equalsIgnoreCase(fit) ||
