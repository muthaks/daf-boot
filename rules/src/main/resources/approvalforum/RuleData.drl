                $data.addListModelNextRank("Banks Business Representative Approval List", 1, 1); //min max
                $data.addListModelNextRank("Banks Approval List - CAT B", 0, 1); //min max
                $data.setRuleExecuted(true);
                displayRuleTriggered(drools);
        end
    */

    rule "MeetingTypeFinancialInstitutionDmType2Bank"
    agenda-group "MeetingTypeFinancialInstitutionDmType2RG"
    activation-group "MeetingTypeFinancialInstitutionDmType2AG"
    salience 9999
        when
            $data: ApprovalForumData(bank)
        then
            $data.setTotalNumberOfApprovalsRequired(1);
            $data.addListModel("Financial Institutions DM Type 2 - Banks Approval List", 1, 1, 1); //min max rank
            $data.setRuleExecuted(true);
            displayRuleTriggered(drools);
    end

    rule "MeetingTypeFinancialInstitutionDmType2NotBank"
    agenda-group "MeetingTypeFinancialInstitutionDmType2RG"
    activation-group "MeetingTypeFinancialInstitutionDmType2AG"
    salience 9999
        when
            $data: ApprovalForumData(!bank)
        then
            displayRuleTriggered(drools);
            drools.setFocus("WatchlistRG");
            drools.setFocus("LocalInternationalRG");
            drools.setFocus("MeetingTypeFinancialInstitutionDmType2FinRG");
    end

        rule "MeetingTypeFinancialInstitutionDmType2FinAmRf"
        agenda-group "MeetingTypeFinancialInstitutionDmType2FinRG"
        activation-group "MeetingTypeFinancialInstitutionDmType2FinAG"
        salience 9999
            when
                $data: ApprovalForumData("Asset Management Companies".equalsIgnoreCase(fit) ||
                                         "Unit Trust Management Companies".equalsIgnoreCase(fit) ||
                                         "Unit Trust Funds".equalsIgnoreCase(fit) ||
                                         "Pension Funds".equalsIgnoreCase(fit) ||
                                         "Provident Funds".equalsIgnoreCase(fit) ||
                                         "Retirement Funds".equalsIgnoreCase(fit))
            then
                $data.addTotalNumberOfApprovalsRequired(2);
                $data.addListModelNextRank("NBFI DM B Approval List - CAT A", 1, 1); //min max
                $data.addListModelNextRank("NBFI Business Representative Approval List", 1, 1); //min max

                $data.addNewModel();
                $data.addTotalNumberOfApprovalsRequired(1);
                $data.addListModelNextRank("NBFI DM B Approval List - CAT A", 1, 1); //min max

                $data.setRuleExecuted(true);
                displayRuleTriggered(drools);
        end

        rule "MeetingTypeFinancialInstitutionDmType2FinOther"
        agenda-group "MeetingTypeFinancialInstitutionDmType2FinRG"
        activation-group "MeetingTypeFinancialInstitutionDmType2FinAG"
        salience 9999
            when
                $data: ApprovalForumData()
            then
                $data.addTotalNumberOfApprovalsRequired(3);
                $data.addListModelNextRank("NBFI DM B Approval List - CAT A", 2, 2); //min max
                $data.addListModelNextRank("NBFI Business Representative Approval List", 1, 1); //min max

                $data.addNewModel();
                $data.addTotalNumberOfApprovalsRequired(1);
                $data.addListModelNextRank("NBFI DM B Approval List - CAT A", 1, 1); //min max

                $data.setRuleExecuted(true);
                displayRuleTriggered(drools);
        end

