package za.co.rmb.approvalforumdrools;

import za.co.rmb.approvalforumdrools.rules.approvalforum.data.ApprovalForumData;
import za.co.rmb.approvalforumdrools.rules.approvalforum.data.ApprovalForumMetadata;

import function za.co.rmb.approvalforumdrools.engine.ApprovalForumDroolsEngineUtil.displayRuleTriggered;

dialect "java"

// ---------------------------------------------------------------------------------------------------------------------
// Corporate Mandates
// ---------------------------------------------------------------------------------------------------------------------

rule "MeetingTypeReviewMandate"
activation-group "all"
salience 99999
    when
        $data: ApprovalForumData("REVIEW_MANDATE".equals(meetingRule))
    then
        displayRuleTriggered(drools);
        drools.setFocus("CounterpartyTypeCorporateMeetingTypeReviewMandateRG");
end

    rule "CorporateReviewMandateNotWatchList"
    agenda-group "CounterpartyTypeCorporateMeetingTypeReviewMandateRG"
    activation-group "CounterpartyTypeCorporateMeetingTypeReviewMandateAG"
    salience 9999
        when
            $data: ApprovalForumData(!ApprovalForumMetadata.DISTRESS_STATUS_WATCHLIST.equals(distressStatus))
        then
            $data.setTotalNumberOfApprovalsRequired(3);
            $data.addListModel("Corporates - Review Mandate Category A Approval List", 2, 0, 1); //min max rank
            $data.addListModel("Corporates - Review Mandate Category B Approval List", 0, 1, 2); //min max rank
            $data.setRuleExecuted(true);
            displayRuleTriggered(drools);
    end

    rule "CorporateReviewMandateWatchList"
    agenda-group "CounterpartyTypeCorporateMeetingTypeReviewMandateRG"
    activation-group "CounterpartyTypeCorporateMeetingTypeReviewMandateAG"
    salience 9999
        when
            $data: ApprovalForumData(ApprovalForumMetadata.DISTRESS_STATUS_WATCHLIST.equals(distressStatus))
        then
            $data.setTotalNumberOfApprovalsRequired(4);
            $data.addListModel("Watchlist Approval List", 1, 1, 1); //min max rank
            $data.addListModel("Corporates - Review Mandate Category A Approval List", 2, 0, 2); //min max rank
            $data.addListModel("Corporates - Review Mandate Category B Approval List", 0, 1, 3); //min max rank
            $data.setRuleExecuted(true);
            displayRuleTriggered(drools);
    end

// ---------------------------------------------------------------------------------------------------------------------

