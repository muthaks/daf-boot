//Financial Institutions Review Mandate
//Financial Institutions and Country Delegated Round Robin Approval
rule "MeetingTypeFinancialInstitutionReviewMandate"
activation-group "all"
salience 99999
    when
        $data: ApprovalForumData("FINANCIAL_INSTITUTIONS_REVIEW_MANDATE".equals(meetingRule))
    then
        displayRuleTriggered(drools);
        drools.setFocus("MeetingTypeFinancialInstitutionReviewMandateRG");
end

    rule "MeetingTypeFinancialInstitutionReviewMandateBank"
    agenda-group "MeetingTypeFinancialInstitutionReviewMandateRG"
    activation-group "MeetingTypeFinancialInstitutionReviewMandateAG"
    salience 9999
        when
            $data: ApprovalForumData(bank)
        then
            displayRuleTriggered(drools);
            drools.setFocus("MeetingTypeFinancialInstitutionReviewMandateBankRG");
    end

    rule "MeetingTypeFinancialInstitutionReviewMandateNotBank"
    agenda-group "MeetingTypeFinancialInstitutionReviewMandateRG"
    activation-group "MeetingTypeFinancialInstitutionReviewMandateAG"
    salience 9999
        when
            $data: ApprovalForumData(!bank)
        then
            displayRuleTriggered(drools);
            drools.setFocus("WatchlistRG");
            drools.setFocus("LocalInternationalRG");
            drools.setFocus("MeetingTypeFinancialInstitutionReviewMandateFinRG");
    end

        /* CA-2088 These were the new rules, but it was decided this needs to be replaced with the old rules
        rule "MeetingTypeFinancialInstitutionReviewMandateBankOnly"
        agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankRG"
        activation-group "MeetingTypeFinancialInstitutionReviewMandateBankAG"
        salience 9999
            when
                $data: ApprovalForumData()
            then
                $data.addTotalNumberOfApprovalsRequired(4);
                $data.addListModelNextRank("Banks Approval List - CAT A", 1, 0); //min max
                $data.addListModelNextRank("Banks DRR Independent Credit Members", 1, 0); //min max
                $data.addListModelNextRank("Banks Business Representative Approval List", 1, 1); //min max
                $data.setRuleExecuted(true);
                displayRuleTriggered(drools);
        end
        */

        rule "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchList"
        agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankRG"
        activation-group "MeetingTypeFinancialInstitutionReviewMandateBankAG"
        salience 9999
            when
                $data: ApprovalForumData(!ApprovalForumMetadata.DISTRESS_STATUS_WATCHLIST.equals(distressStatus))
            then
                displayRuleTriggered(drools);
                drools.setFocus("MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListRG");
        end

            rule "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListNotIndia"
            agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListRG"
            activation-group "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListAG"
            salience 9999
                when
                    $data: ApprovalForumData(!isRiskTakerGroupCode(ApprovalForumMetadata.INDIA))
                then
                    $data.setTotalNumberOfApprovalsRequired(5);
                    $data.addListModel("Financial Institutions - Review Mandate Category A Approval List", 3, 0, 1); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category B Approval List", 0, 2, 2); //min max rank
                    $data.setRuleExecuted(true);
                    displayRuleTriggered(drools);
            end

            rule "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListIndia"
            agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListRG"
            activation-group "MeetingTypeFinancialInstitutionReviewMandateBankNotWatchListAG"
            salience 9999
                when
                    $data: ApprovalForumData(isRiskTakerGroupCode(ApprovalForumMetadata.INDIA))
                then
                    $data.setTotalNumberOfApprovalsRequired(5);
                    $data.addListModel("Financial Institutions - Review Mandate India Category A Approval List", 1, 1, 1); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate India Category Approval List", 1, 1, 2); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category A Approval List", 1, 0, 3); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category B Approval List", 0, 2, 4); //min max rank

                    $data.setRuleExecuted(true);
                    displayRuleTriggered(drools);
            end

        rule "MeetingTypeFinancialInstitutionReviewMandateBankWatchList"
        agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankRG"
        activation-group "MeetingTypeFinancialInstitutionReviewMandateBankAG"
        salience 9999
            when
                $data: ApprovalForumData(ApprovalForumMetadata.DISTRESS_STATUS_WATCHLIST.equals(distressStatus))
            then
                displayRuleTriggered(drools);
                drools.setFocus("MeetingTypeFinancialInstitutionReviewMandateBankWatchListRG");
        end

            rule "MeetingTypeFinancialInstitutionReviewMandateBankWatchListNotIndia"
            agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankWatchListRG"
            activation-group "MeetingTypeFinancialInstitutionReviewMandateBankWatchListAG"
            salience 9999
                when
                    $data: ApprovalForumData(!isRiskTakerGroupCode(ApprovalForumMetadata.INDIA))
                then
                    $data.setTotalNumberOfApprovalsRequired(6);
                    $data.addListModel("Financial Institutions - Watchlist Approval List", 1, 1, 1); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category A Approval List", 3, 0, 2); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category B Approval List", 0, 2, 3); //min max rank
                    $data.setRuleExecuted(true);
                    displayRuleTriggered(drools);
            end

            rule "MeetingTypeFinancialInstitutionReviewMandateBankWatchListIndia"
            agenda-group "MeetingTypeFinancialInstitutionReviewMandateBankWatchListRG"
            activation-group "MeetingTypeFinancialInstitutionReviewMandateBankWatchListAG"
            salience 9999
                when
                    $data: ApprovalForumData(isRiskTakerGroupCode(ApprovalForumMetadata.INDIA))
                then
                    $data.setTotalNumberOfApprovalsRequired(6);
                    $data.addListModel("Financial Institutions - Watchlist Approval List", 1, 1, 1); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate India Category A Approval List", 1, 1, 2); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate India Category Approval List", 1, 1, 3); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category A Approval List", 1, 0, 4); //min max rank
                    $data.addListModel("Financial Institutions - Review Mandate Category B Approval List", 0, 2, 5); //min max rank
                    $data.setRuleExecuted(true);
                    displayRuleTriggered(drools);
            end

        rule "MeetingTypeFinancialInstitutionReviewMandateFinAmRf"
        agenda-group "MeetingTypeFinancialInstitutionReviewMandateFinRG"
        activation-group "MeetingTypeFinancialInstitutionReviewMandateFinAG"
        salience 9999
            when
                $data: ApprovalForumData("Asset Management Companies".equalsIgnoreCase(fit) ||
                                         "Unit Trust Management Companies".equalsIgnoreCase(fit) ||
                                         "Unit Trust Funds".equalsIgnoreCase(fit) ||
                                         "Pension Funds".equalsIgnoreCase(fit) ||
                                         "Provident Funds".equalsIgnoreCase(fit) ||
                                         "Retirement Funds".equalsIgnoreCase(fit))
            then
                $data.addTotalNumberOfApprovalsRequired(3);
                $data.addListModelNextRank("NBFI DRR Approval List - CAT A", 1, 1); //min max
                $data.addListModelNextRank("NBFI DRR Independent Credit Members", 1, 1); //min max
                $data.addListModelNextRank("NBFI Business Representative Approval List", 1, 1); //min max
                $data.setRuleExecuted(true);
                displayRuleTriggered(drools);
        end

        rule "MeetingTypeFinancialInstitutionReviewMandateFinOther"
        agenda-group "MeetingTypeFinancialInstitutionReviewMandateFinRG"
        activation-group "MeetingTypeFinancialInstitutionReviewMandateFinAG"
        salience 9999
            when
                $data: ApprovalForumData()
            then
                $data.addTotalNumberOfApprovalsRequired(4);
                $data.addListModelNextRank("NBFI DRR Approval List - CAT A", 1, 0); //min max
                $data.addListModelNextRank("NBFI DRR Independent Credit Members", 1, 0); //min max
                $data.addListModelNextRank("NBFI Business Representative Approval List", 1, 1); //min max
                $data.setRuleExecuted(true);
                displayRuleTriggered(drools);
        end

