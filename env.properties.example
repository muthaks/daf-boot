# DAF Committee Agendas remote (daf-boot) — server configuration
# Copy this file to env.properties and fill in the values for this server.
# env.properties is the only hand-maintained file (cat-utils docs/DEPLOYMENT.md).

# ── Host port the platform nginx proxies to (5-digit, see DEPLOYMENT.md "Host ports") ──
# https://credit-systems-<env>.rmb.co.za/platform/remotes/daf/ -> REMOTE_PORT
# Changing it means changing docker-base/nginx/platform/credit-platform.conf too
# (deploy/check-ports.sh first).
REMOTE_PORT=14708

# ── Remote (browser) configuration, rendered into assets/config.json at container start ──
# Absolute prefix of the DAF (approvalforum) API as the browser reaches it: the Credit API gateway's
# /daf route (co-api-gateway), which proxies to <DAF server>/approvalforum/api. The remote calls
# /auth/ssoServers, /auth/tenant, /auth/ssoToken and /approvalForum/agenda/... under it.
DAF_API_URL=https://credit-systems-dev.rmb.co.za/gateway/daf
