# DAF (daf-boot) — server configuration for daf-api, daf-rules, daf-docgen and daf-soap
# Copy this file to env.properties and fill in the values for this server.
# env.properties is the only hand-maintained file (cat-utils docs/DEPLOYMENT.md).
#
# These are the legacy containers' variables, read by the same legacy code. A variable that is set replaces
# the legacy default even when it is empty, so optional settings stay commented out until they are needed.
# Values are written without quotes.
# The internal URLs between the four services (AF_BASE, AF_RULESSERVICE_BASE, AF_DOCGENSERVICE_BASE) are set
# in docker-compose.yml.

# ── Host ports (5-digit, see DEPLOYMENT.md "Host ports") ──
API_PORT=14736
RULES_PORT=14737
DOCGEN_PORT=14738
SOAP_PORT=14739

TZ=Africa/Johannesburg
AF_ENV=DEV

# ── Database (daf-api and daf-rules) ──
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
DB_URL=jdbc:sqlserver://<host>:1433;DatabaseName=wc_approvalforum
DB_USER=s_approvalforum
DB_PASSWORD=

# ── JWT (the API's own login tokens, the rules and docgen services) ──
# The key DAF signs its tokens with; unset, the services use their built-in key (the legacy DAF's). Set it only
# to replace that key, at least 32 characters, the same value for the API, rules and docgen.
#authentication.jwt.secret=
AF_DEV_USERS=
AF_ADROLE_OU=OU=DAF,OU=Credit,OU=Applications,OU=Rand Merchant Bank,DC=rmb,DC=co,DC=za
AF_SSO_SERVERS=https://rmb-r1vdvcrsk03.rmb.co.za/auth/,https://rmb-rbvtsrska01:8443/auth/,https://rmb-rbvtsrskd01:8443/auth/,https://rmb-rbvutrska01:8443/auth/,https://rmb-rbvutrskd01:8443/auth/
# The auth service DAF signs users in with and looks users, groups and domains up in: auth-service-boot
# through the API gateway (/gateway/auth -> /api/v1/*). Never leave it blank: an empty value replaces the
# legacy default and sign-in fails.
AF_AUTHSERVICE_BASE=https://credit-systems-dev.rmb.co.za/gateway/auth

# ── Scheduler (Quartz cron expressions; the defaults are in the legacy code) ──
AF_SCHEDULER_DAILY_EMAIL_CRON=0 49 11 ? * MON-FRI
AF_SCHEDULER_DAILY_UNSENT_EMAILS_CRON=0 0 11,15,19 ? * MON-FRI
AF_SCHDULER_CLEANUP_CRON=0 */5 * ? * MON-FRI
AF_SCHEDULER_EMAIL_RECEIVED_CRON=0 0 * ? * MON-FRI
#AF_SCHEDULER_CRON=
#AF_SCHDULER_ADU_CLEANUP_CRON=

# ── Credit data: RMB (tenant 1) and Ashburton (tenant 2) ──
# Credit Data Boot through the API gateway: /creditdata/<service> reads RMB's CASDM, /creditdata/ash/<service>
# Ashburton's (the gateway marks those requests for Ashburton's database). DAF calls them with a CREDITDATA system
# token from the auth service, with DAF's system sign-in (AF_SYSTEM_TOKEN_URL, AF_SYSTEM_CALLER,
# AF_SYSTEM_BOOTSTRAP_CLIENT_SECRET below); the auth service must list DAF in
# AUTH_SYSTEM_TOKENS_CREDITDATA. No Credit Data token settings are needed.
AF_APPLICATIONSERVICE_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/application
AF_APPLICATIONSERVICE_ASH_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/ash/application
AF_COUNTERPARTYSERVICE_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/counterparty
AF_COUNTERPARTYSERVICE_ASH_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/ash/counterparty
AF_FACILITYSERVICE_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/facility
AF_FACILITYSERVICE_ASH_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/ash/facility
AF_REFDATASERVICE_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/referencedata
AF_REFDATASERVICE_ASH_BASE=https://credit-systems-dev.rmb.co.za/gateway/creditdata/ash/referencedata

# ── CASDM, Lumos, list management, holidays ──
AF_CASDMREST_BASE=
AF_CASDMREST_APIKEY=
AF_LUMOSSERVICE_BASE=
AF_LUMOSSERVICE_ORCHESTRATION_TOKEN=
AF_LISTMANAGEMENTSERVICE_BASE=https://rmb-rbvdvcrsk01.fnb.co.za/listmanagement/api
AF_HOLIDAYSERVICE_URL=

# ── Mail ──
AF_MAIL_ENV=PROD
AF_MAIL_ENABLED=true
AF_MAIL_BASE=
AF_MAIL_ATTACHMENT_ZIP=false
# ── DAF's system sign-in to the auth service (for its Mail Service and Credit Data tokens) ──
# DAF's registered system and its Bootstrap Client Secret (auth service admin page, system DAF, Secrets: the
# 43-character Bootstrap Client Secret, not the JWT Signing Secret).
# The auth service must list DAF in AUTH_SYSTEM_TOKENS_MAILSERVICE and AUTH_SYSTEM_TOKENS_CREDITDATA.
# The same two settings let DAF verify the platform sign-in (POST /auth/platformToken, docs/AUTHENTICATION.md):
# the secret is exchanged at AF_AUTHSERVICE_BASE for DAF's JWT signing secret.
AF_SYSTEM_TOKEN_URL=https://credit-systems-dev.rmb.co.za/gateway/auth/api/v1/auth/system-token
AF_SYSTEM_CALLER=DAF
AF_SYSTEM_BOOTSTRAP_CLIENT_SECRET=
# Optional: the iss claim the auth service stamps (its JWT_ISSUER); blank = platform tokens' issuer not checked
AF_PLATFORM_TOKEN_ISSUER=

# Mail goes to mailservice-boot through the API gateway (/gateway/mailservice -> /api/mail/send) with a MAILSERVICE
# system token; with DAF's system sign-in set, AF_MAILSERVICE_TOKEN is not used.
AF_MAILSERVICE_BASE=https://credit-systems-dev.rmb.co.za/gateway/mailservice
AF_MAILSERVICE_AUDIENCE=MAILSERVICE
#AF_MAILSERVICE_TOKEN=
AF_LUMOS_MAILSERVICE_TOKEN=
AF_MAILSERVICE_APPROVAL_MAILTO=
AF_CORP_CREDIT_SECRETARY_MAIL=
AF_CORP_CREDIT_SPECIALIST_MAIL=

# ── Microsoft Graph (meeting invitations) ──
AF_GRAPH_TENANT_ID=
AF_GRAPH_CLIENT_ID=
AF_GRAPH_CLIENT_SECRET=
AF_GRAPH_ORGANIZER=
#AF_GRAPH_PROXY_HOST=
#AF_GRAPH_PROXY_PORT=

# ── Documents, notifications, agenda UI ──
AF_DOCGENSERVICE_TOKEN=
AF_DOCSTASH_BASE=
AF_DOCSTASHSERVICE_BASE=
AF_SOCKETIO_URL=
AF_SOCKETIO_TOKEN=
AF_AGENDA_UI_BASE=
AF_APPLICATION_MEETING_NAMES=Review Mandate;Delegated Mandate Category A;Delegated Mandate Category A (Team Lead);Review Mandate REIB;Delegated Mandate REIB Category A;Delegated Mandate REIB Category B;Delegated Mandate Category B;Financial Institutions Review Mandate;Financial Institutions DM Type 1;Financial Institutions DM Type 1 (Team Lead);Financial Institutions DM Type 2;Diversified Mandate;Diversified Credit Delegated Mandate;Delegated Mandate REIB (Team Lead)

# ── SOAP (daf-soap): the WS-Security user external callers send, the token it calls the API with ──
AF_SOAP_USER=
AF_SOAP_PASS=
#AF_TOKEN=

# ── Logging (the legacy logback levels) ──
DEFAULT_LOG_LEVEL=INFO
TOMCAT_LOG_LEVEL=INFO
HIBERNATE_LOG_LEVEL=WARN
