{
  "description": "DAF request life cycle (as the platform DAF remote drives it): new request data, work in progress create, update, assign and unassign, document upload, chat and preferences, submit, approver assignment and decisions, a second request deleted, then the processing endpoints the scheduled jobs call (external requests, mail, cleanup, DocStash), the auth endpoints and the read-only checks around them.",
  "ignore_columns": ["RI_RevisionInfo.RevTstmp"],
  "variables": {"me": "superuser@rmb.co.za"},
  "steps": [
    {"name": "new request data", "method": "GET", "path": "/approvalForum/new/CD00007",
     "save": {"cfd": "$.counterpartyFullDetail", "rules": "$.rulesResponse.response", "users": "$.usersResponse.response", "chair": "$.chairpersonApprovalRequired"}},
    {"name": "create work in progress", "method": "POST", "path": "/approvalForum/request/wip", "query": {"tenantId": "1"},
     "body": {"externalRequest": false,
              "data": {"confidential": false, "counterpartyFullDetail": "${cfd}", "recommendation": "Parity recommendation", "chairRecommendation": "",
                       "specific": false, "specificReason": "", "chairpersonApprovalRequired": "${chair}", "rulesResponse": "${rules}",
                       "usersResponse": "${users}", "status": "Wip", "type": "Credit Application"}},
     "save": {"wf": "$.workflowId"}},
    {"name": "read as capturer", "method": "GET", "path": "/approvalForum/capturer/${wf}", "query": {"tenantId": "1"}},
    {"name": "update work in progress", "method": "PUT", "path": "/approvalForum/request/wip", "query": {"tenantId": "1"},
     "body": {"workflowId": "${wf}",
              "data": {"confidential": false, "counterpartyFullDetail": "${cfd}", "recommendation": "Parity recommendation, updated", "chairRecommendation": "",
                       "specific": false, "specificReason": "", "chairpersonApprovalRequired": "${chair}", "rulesResponse": "${rules}",
                       "usersResponse": "${users}", "status": "Wip", "type": "Credit Application"}}},
    {"name": "can assign wip", "method": "POST", "path": "/approvalForum/canAssign/wip/${wf}", "body": ""},
    {"name": "unassign wip", "method": "POST", "path": "/approvalForum/unassign/wip/${wf}", "body": ""},
    {"name": "assign wip", "method": "POST", "path": "/approvalForum/assign/wip/${wf}", "body": ""},
    {"name": "can view", "method": "POST", "path": "/approvalForum/canView/${wf}", "body": ""},
    {"name": "upload document", "method": "POST", "path": "/documents/upload",
     "multipart": {"fields": {"appID": "${wf}", "docDescription": "", "createdBy": "${me}", "docType": "Credit Paper"},
                   "files": {"file": {"name": "parity-application.pdf", "type": "application/pdf", "content": "%PDF-1.4 parity application"}}}},
    {"name": "documents", "method": "GET", "path": "/documents/list", "query": {"workflowId": "${wf}"}},
    {"name": "chat", "method": "POST", "path": "/approvalForum/chat", "body": {"workflowId": "${wf}", "chatText": "Parity chat message"}},
    {"name": "read chat", "method": "GET", "path": "/approvalForum/chat/${wf}", "query": {"tenantId": "1"}, "save": {"chatId": "$.chats[0].chatId"}},
    {"name": "chat seen", "method": "PUT", "path": "/approvalForum/chat/capturer", "body": {"workflowId": "${wf}", "chatId": "${chatId}"}},
    {"name": "user preference", "method": "PUT", "path": "/approvalForum/user/preference",
     "body": {"userPreference": {"userId": "${me}", "chatSortAscending": true}}},
    {"name": "read preference", "method": "GET", "path": "/approvalForum/user/preference"},
    {"name": "submit", "method": "POST", "path": "/approvalForum/request", "query": {"tenantId": "1"},
     "body": {"workflowId": "${wf}",
              "data": {"confidential": false, "counterpartyFullDetail": "${cfd}", "recommendation": "Parity recommendation, updated", "chairRecommendation": "",
                       "specific": false, "specificReason": "", "chairpersonApprovalRequired": "${chair}", "rulesResponse": "${rules}",
                       "usersResponse": "${users}", "status": "Wip", "type": "Credit Application"}}},
    {"name": "read as approver", "method": "GET", "path": "/approvalForum/approver/${wf}", "query": {"tenantId": "1"}},
    {"name": "can assign", "method": "POST", "path": "/approvalForum/canAssign/${wf}", "body": ""},
    {"name": "assign", "method": "POST", "path": "/approvalForum/assign/${wf}", "body": ""},
    {"name": "save decision", "method": "PUT", "path": "/approvalForum/decision/${wf}",
     "body": {"workflowId": "${wf}", "decision": "Approved", "conditions": "", "policyApprovalMandate": ""}},
    {"name": "submit decision", "method": "POST", "path": "/approvalForum/decision/${wf}",
     "body": {"workflowId": "${wf}", "decision": "Approved", "conditions": "", "policyApprovalMandate": ""}},
    {"name": "unassign", "method": "POST", "path": "/approvalForum/unassign/${wf}", "body": ""},
    {"name": "lists", "method": "GET", "path": "/approvalForum/list/analyst", "query": {"start": "0", "size": "20", "tenantId": "1"}},

    {"name": "second work in progress", "method": "POST", "path": "/approvalForum/request/wip", "query": {"tenantId": "1"},
     "body": {"externalRequest": false,
              "data": {"confidential": false, "counterpartyFullDetail": "${cfd}", "recommendation": "To be deleted", "chairRecommendation": "",
                       "specific": false, "specificReason": "", "chairpersonApprovalRequired": "${chair}", "rulesResponse": "${rules}",
                       "usersResponse": "${users}", "status": "Wip", "type": "Credit Application"}},
     "save": {"wf2": "$.workflowId"}},
    {"name": "delete work in progress", "method": "DELETE", "path": "/approvalForum/request/wip/${wf2}", "query": {"tenantId": "1"}},

    {"name": "process external requests", "method": "POST", "path": "/approvalForum/request/external/process"},
    {"name": "create external requests", "method": "POST", "path": "/approvalForum/request/external/create"},
    {"name": "cancel external requests", "method": "POST", "path": "/approvalForum/request/external/cancel"},
    {"name": "cleanup requests", "method": "POST", "path": "/approvalForum/request/cleanup"},
    {"name": "mail escalations", "method": "POST", "path": "/approvalForum/mail/escalations"},
    {"name": "send unsent mail", "method": "POST", "path": "/approvalForum/mail/sendUnsent"},
    {"name": "docstash process", "method": "POST", "path": "/docstash/process"},

    {"name": "tenant", "method": "POST", "path": "/auth/tenant",
     "body": {"userPrincipalName": "superuser@rmb.co.za", "hostDomain": "rmb.co.za", "groups": ["G_DAF_DEV_Ashburton_CreditAnalyst"]}},
    {"name": "role token from a bad SSO token", "method": "POST", "path": "/auth/roleToken", "body": "not-a-token"},
    {"name": "rules", "method": "POST", "path": "/approvalForum/rules", "body": {}}
  ]
}
