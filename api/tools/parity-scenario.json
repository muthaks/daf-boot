{
  "description": "Agenda Builder life cycle (as the platform remote drives it): book, edit, participants, conditions, document upload and validation, submit, return, approve, reject, reopen, remove; meeting compile, lock, status, held, records, post-meeting, close, reopen; committee create, update, deactivate; meeting create, update, cancel; cut-off and reminder processing.",
  "ignore_columns": ["RI_RevisionInfo.RevTstmp"],
  "steps": [
    {"name": "committee dates", "method": "GET", "path": "/approvalForum/agenda/committees/11/dates", "save": {"meetingDate": "$[1]", "laterDate": "$[2]"}},
    {"name": "book item", "method": "POST", "path": "/approvalForum/agenda/items",
     "body": {"agcId": 11, "meetingDate": "${meetingDate}", "heldVia": "Microsoft Teams",
              "item": {"counterpartyName": "Parity Test Co", "businessUnit": "Corporates", "purposeOfSubmission": "Annual review",
                       "ratingBand": "B2 - B3", "estimatedMinutes": 30, "numberOfPages": 20,
                       "primaryAnalyst": "Super User", "primaryAnalystId": "superuser@rmb.co.za"}},
     "save": {"agiId": "$.agiId", "agmId": "$.agmId"}},
    {"name": "read item", "method": "GET", "path": "/approvalForum/agenda/items/${agiId}", "save": {"item": "$"}},
    {"name": "edit item", "method": "PUT", "path": "/approvalForum/agenda/items", "body": "${item}",
     "merge": {"comments": "Edited by parity", "estimatedMinutes": 45, "dcpZar": 125000000.5}},
    {"name": "participants", "method": "PUT", "path": "/approvalForum/agenda/items/${agiId}/participants",
     "body": [{"agiId": "${agiId}", "personId": "superuser@rmb.co.za", "personName": "Super User", "email": "superuser@rmb.co.za",
               "committeeRole": "Chairperson", "independentFlag": false, "plannedAttendance": "In person"},
              {"agiId": "${agiId}", "personId": "approver@rmb.co.za", "personName": "An Approver", "email": "approver@rmb.co.za",
               "committeeRole": "Member", "independentFlag": true, "plannedAttendance": "Virtual"}]},
    {"name": "conditions", "method": "PUT", "path": "/approvalForum/agenda/items/${agiId}/conditions",
     "body": [{"agiId": "${agiId}", "conditionType": "Pre-disbursement", "description": "Parity condition",
               "ownerId": "superuser@rmb.co.za", "ownerName": "Super User", "dueDate": "${laterDate}", "status": "Open"}],
     "save": {"agcaId": "$[0].agcaId"}},
    {"name": "upload document", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/upload",
     "multipart": {"fields": {"docType": "Credit Paper"},
                   "files": {"file": {"name": "parity-paper.pdf", "type": "application/pdf", "content": "%PDF-1.4 parity"}}}},
    {"name": "read item after upload", "method": "GET", "path": "/approvalForum/agenda/items/${agiId}", "save": {"agidId": "$.documents[0].agidId"}},
    {"name": "validate document", "method": "POST", "path": "/approvalForum/agenda/documents/${agidId}/validate",
     "query": {"status": "Accepted", "comment": "Parity check"}},
    {"name": "quorum", "method": "GET", "path": "/approvalForum/agenda/items/${agiId}/quorum"},
    {"name": "submit", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/submit", "query": {"quorumOverrideReason": "Parity override"}},
    {"name": "return", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/return", "query": {"reason": "Parity return"}},
    {"name": "resubmit", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/submit", "query": {"quorumOverrideReason": "Parity override"}},
    {"name": "approve", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/approve", "query": {"comments": "Parity approved"}},
    {"name": "actions", "method": "GET", "path": "/approvalForum/agenda/items/${agiId}/actions"},
    {"name": "notifications", "method": "GET", "path": "/approvalForum/agenda/items/${agiId}/notifications"},
    {"name": "close condition", "method": "POST", "path": "/approvalForum/agenda/conditions/${agcaId}/close",
     "query": {"status": "Closed", "comments": "Met"}},
    {"name": "meeting", "method": "GET", "path": "/approvalForum/agenda/meetings/${agmId}"},
    {"name": "compile", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/compile"},
    {"name": "lock", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/lock"},
    {"name": "status", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/status", "query": {"status": "Agenda Issued"}},
    {"name": "held", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/held",
     "query": {"actualStartTime": "09:00", "actualEndTime": "10:15", "quorumAchieved": "true"}},
    {"name": "meeting record", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/records",
     "body": {"agmId": "${agmId}", "recordType": "Minutes", "name": "parity-minutes.pdf", "location": "docstash://parity"}},
    {"name": "records", "method": "GET", "path": "/approvalForum/agenda/meetings/${agmId}/records"},
    {"name": "post-meeting", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/postMeeting",
     "body": {"agiId": "${agiId}", "actualPages": 22, "actualMinutes": 35, "decision": "Approved", "decisionType": "Approved",
              "creditConditions": "As tabled", "attendeesPresent": "Super User; An Approver", "minuteTaker": "Super User",
              "actualRating": "B2", "actualPurpose": "Annual review", "actualDcp": 125000000.5}},
    {"name": "post-meeting read", "method": "GET", "path": "/approvalForum/agenda/items/${agiId}/postMeeting"},
    {"name": "post-meeting unlock", "method": "POST", "path": "/approvalForum/agenda/items/${agiId}/postMeeting/unlock"},
    {"name": "close meeting", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/close"},
    {"name": "reopen meeting", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/reopen", "query": {"reason": "Parity reopen"}},
    {"name": "reschedule", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmId}/reschedule"},

    {"name": "book second item", "method": "POST", "path": "/approvalForum/agenda/items",
     "body": {"agcId": 11, "meetingDate": "${laterDate}", "heldVia": "Microsoft Teams",
              "item": {"counterpartyName": "Parity Reject Co", "businessUnit": "Corporates", "purposeOfSubmission": "New deal",
                       "estimatedMinutes": 15, "primaryAnalyst": "Super User", "primaryAnalystId": "superuser@rmb.co.za"}},
     "save": {"agi2": "$.agiId", "agm2": "$.agmId"}},
    {"name": "submit second", "method": "POST", "path": "/approvalForum/agenda/items/${agi2}/submit", "query": {"quorumOverrideReason": "Parity override"}},
    {"name": "reject second", "method": "POST", "path": "/approvalForum/agenda/items/${agi2}/reject", "query": {"reason": "Parity reject"}},
    {"name": "reopen second", "method": "POST", "path": "/approvalForum/agenda/items/${agi2}/reopen", "query": {"reason": "Parity reopen"}},
    {"name": "remove second", "method": "POST", "path": "/approvalForum/agenda/items/${agi2}/remove", "query": {"reason": "Parity withdrawn"}},
    {"name": "my items", "method": "GET", "path": "/approvalForum/agenda/items/my"},

    {"name": "create committee", "method": "POST", "path": "/approvalForum/agenda/committees",
     "body": {"committeeName": "Parity Committee", "mandateLevel": "L1", "levelDescription": "Parity level", "quorumSize": 2,
              "meetingDay": "Tuesday", "chair": "Super User", "chairId": "superuser@rmb.co.za", "meetingSecretary": "Super User",
              "meetingSecretaryId": "superuser@rmb.co.za", "pageGuidance": 50, "effectiveFrom": "${meetingDate}",
              "defaultHeldVia": "Microsoft Teams", "defaultDurationMinutes": 60, "cutOffDayOfWeek": "Thursday", "cutOffTime": "17:00",
              "requiredDocTypes": "Credit Paper", "quorumRoles": "Chairperson;Member"},
     "save": {"agcNew": "$.agcId", "committee": "$"}},
    {"name": "update committee", "method": "PUT", "path": "/approvalForum/agenda/committees", "body": "${committee}",
     "merge": {"quorumSize": 3, "levelDescription": "Parity level updated"}},
    {"name": "create meeting", "method": "POST", "path": "/approvalForum/agenda/meetings",
     "body": {"agcId": "${agcNew}", "meetingDate": "${laterDate}", "heldVia": "Microsoft Teams", "startTime": "10:00", "endTime": "11:00", "venue": "Parity room"},
     "save": {"agmNew": "$.agmId", "meetingNew": "$"}},
    {"name": "update meeting", "method": "PUT", "path": "/approvalForum/agenda/meetings/${agmNew}", "body": "${meetingNew}",
     "merge": {"venue": "Parity boardroom", "endTime": "11:30"}},
    {"name": "cancel meeting", "method": "POST", "path": "/approvalForum/agenda/meetings/${agmNew}/cancel", "query": {"reason": "Parity cancel"}},
    {"name": "deactivate committee", "method": "POST", "path": "/approvalForum/agenda/committees/${agcNew}/deactivate"},
    {"name": "committees", "method": "GET", "path": "/approvalForum/agenda/committees/all"},
    {"name": "meetings in range", "method": "GET", "path": "/approvalForum/agenda/meetings"},
    {"name": "summary report", "method": "GET", "path": "/approvalForum/agenda/reports/summary"},
    {"name": "process cut-off", "method": "POST", "path": "/approvalForum/agenda/processCutOff"},
    {"name": "process reminders", "method": "POST", "path": "/approvalForum/agenda/processReminders"}
  ]
}
