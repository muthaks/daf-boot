{
  "description": "The mutating endpoints the agenda and workflow scenarios do not reach: chairperson submission, memo, specific and additional approver checks, system decision, Ashburton external requests, approver and capturer escalation mail, daily mail resend, the reviewer/approver/chairperson chat markers, DocStash upload and directory cleanup, credentials login, agenda DocStash attach, and the GET endpoints that act (received-mail processing, test mail, document archive). Starting the scheduler is left out: its jobs would then write to both databases at times of their own; SchedulerParityTest covers it.",
  "ignore_columns": ["RI_RevisionInfo.RevTstmp"],
  "variables": {"me": "superuser@rmb.co.za"},
  "steps": [
    {"name": "new request data", "method": "GET", "path": "/approvalForum/new/CD00007",
     "save": {"cfd": "$.counterpartyFullDetail", "rules": "$.rulesResponse.response", "users": "$.usersResponse.response", "chair": "$.chairpersonApprovalRequired"}},
    {"name": "create work in progress", "method": "POST", "path": "/approvalForum/request/wip", "query": {"tenantId": "1"},
     "body": {"externalRequest": false,
              "data": {"confidential": false, "counterpartyFullDetail": "${cfd}", "recommendation": "Chairperson route", "chairRecommendation": "Chair notes",
                       "specific": false, "specificReason": "", "chairpersonApprovalRequired": true, "rulesResponse": "${rules}",
                       "usersResponse": "${users}", "status": "Wip", "type": "Credit Application"}},
     "save": {"wf": "$.workflowId"}},
    {"name": "can assign specific (new)", "method": "POST", "path": "/approvalForum/canAssign/new/specific/${me}",
     "body": {"rulesResponse": "${rules}", "userResponse": "${users}"}},
    {"name": "can assign additional (new)", "method": "POST", "path": "/approvalForum/canAssign/new/additional/${me}", "body": "${rules}"},
    {"name": "submit to chairperson", "method": "POST", "path": "/approvalForum/request/chairperson",
     "body": {"workflowId": "${wf}",
              "data": {"confidential": false, "counterpartyFullDetail": "${cfd}", "recommendation": "Chairperson route", "chairRecommendation": "Chair notes",
                       "specific": false, "specificReason": "", "chairpersonApprovalRequired": true, "rulesResponse": "${rules}",
                       "usersResponse": "${users}", "status": "Wip", "type": "Credit Application"}}},
    {"name": "read as chairperson", "method": "GET", "path": "/approvalForum/chairperson/${wf}", "query": {"tenantId": "1"}},
    {"name": "can assign specific (chair)", "method": "POST", "path": "/approvalForum/canAssign/new/chair/specific/${me}/${wf}",
     "body": {"rulesResponse": "${rules}", "userResponse": "${users}"}},
    {"name": "can assign additional (chair)", "method": "POST", "path": "/approvalForum/canAssign/new/chair/additional/${me}/${wf}", "body": "${rules}"},
    {"name": "chat", "method": "POST", "path": "/approvalForum/chat", "body": {"workflowId": "${wf}", "chatText": "For the chairperson"}},
    {"name": "read chat", "method": "GET", "path": "/approvalForum/chat/${wf}", "query": {"tenantId": "1"}, "save": {"chatId": "$.chats[0].chatId"}},
    {"name": "chat seen (reviewer)", "method": "PUT", "path": "/approvalForum/chat/reviewer", "body": {"workflowId": "${wf}", "chatId": "${chatId}"}},
    {"name": "chat seen (approver)", "method": "PUT", "path": "/approvalForum/chat/approver", "body": {"workflowId": "${wf}", "chatId": "${chatId}"}},
    {"name": "chat seen (chairperson)", "method": "PUT", "path": "/approvalForum/chat/chairperson", "body": {"workflowId": "${wf}", "chatId": "${chatId}"}},
    {"name": "system decision", "method": "POST", "path": "/approvalForum/decision/system/${wf}",
     "body": {"workflowId": "${wf}", "decision": "Referred Back", "conditions": "", "policyApprovalMandate": ""}},
    {"name": "memo", "method": "POST", "path": "/approvalForum/memo", "body": {"workflowId": "${wf}"}},
    {"name": "read as capturer", "method": "GET", "path": "/approvalForum/capturer/${wf}", "query": {"tenantId": "1"}},

    {"name": "ashburton external create", "method": "POST", "path": "/approvalForum/request/external/ashburton/create"},
    {"name": "ashburton external cancel", "method": "POST", "path": "/approvalForum/request/external/ashburton/cancel"},
    {"name": "approver escalation mail", "method": "POST", "path": "/approvalForum/mail/approver"},
    {"name": "capturer escalation mail", "method": "POST", "path": "/approvalForum/mail/capturer"},
    {"name": "resend daily mails", "method": "POST", "path": "/approvalForum/mail/resendDaily"},
    {"name": "test mail", "method": "GET", "path": "/approvalForum/mail/test"},
    {"name": "process received mail", "method": "GET", "path": "/emailReceived/process"},

    {"name": "docstash upload", "method": "POST", "path": "/docstash/upload", "query": {"workflowId": "${wf}"}},
    {"name": "directory user cleanup", "method": "POST", "path": "/docstash/adu/cleanup"},
    {"name": "documents", "method": "GET", "path": "/documents/list", "query": {"workflowId": "79"}, "save": {"documentId": "$.documents[0].asdID"}},
    {"name": "archive document", "method": "GET", "path": "/documents/archive", "query": {"documentId": "${documentId}"}},
    {"name": "documents after archive", "method": "GET", "path": "/documents/list", "query": {"workflowId": "79"}},

    {"name": "agenda attach from docstash", "method": "POST", "path": "/approvalForum/agenda/items/1/document",
     "query": {"docStashId": "999001", "fileName": "from-docstash.pdf"}},
    {"name": "login with credentials", "method": "POST", "path": "/auth/login",
     "headers": {"domain": "rmb.co.za", "username": "superuser", "password": "not-the-password"}}
  ]
}
