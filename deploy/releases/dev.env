# What this repository runs on the platform DEV server (rmb-rbvdvcsdm01): stack = image tag
# (TeamCity build number, or latest). Applied in one PAM session:
#   deploy/pam-deploy.sh --release dev rmb-rbvdvcsdm01 -u <your AD user>
# DEV always runs latest; pinned build numbers belong in the other environments' manifests.
# The API gateway (/daf route) is deployed from cat-utils by the platform team.
daf=latest
