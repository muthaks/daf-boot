# DAF Committee Agendas: the platform remote only (the approvalforum backend stays where DAF runs today).
# STACK_DIR is relative to this repository's root (the stack files sit at the root).
# Deployed on the platform DEV server: deploy/pam-deploy.sh daf-remote rmb-rbvdvcsdm01 -u <your AD user>
# (DEV = :latest; -b <build> only for other environments)
# Image: credit/daf-boot/daf-remote:<BUILD_NUMBER>
STACK_DIR=.
REMOTE_NAME=daf-remote
FILES="docker-compose.yml latest.sh env.properties.example .env.example"
TAG_VAR=BUILD_NUMBER
PORT_VARS="REMOTE_PORT"
# Through the platform nginx: /platform/remotes/daf/ -> REMOTE_PORT.
VERIFY_URL="https://credit-systems-${TARGET_ENV}.rmb.co.za/platform/remotes/daf/remoteEntry.json"
LOG_TAIL_SECONDS=8
