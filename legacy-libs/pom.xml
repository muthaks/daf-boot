<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The shared RMB libraries DAF uses are built on javax.*: the clients (Credit Data, DocStash, auth
         service, mail service, list management) on JAX-RS 2 and javax.inject, the models on
         javax.persistence and javax.xml.bind (three model classes are JPA entities in DAF's persistence
         unit). This module takes the exact jar versions the legacy DAF runs and rewrites them to jakarta.*
         at bytecode level with the Eclipse Transformer, so daf-api runs the same library code on Jersey 4
         and Hibernate 7. Each transformed jar is attached under its original artifactId as classifier;
         nothing else in the jars changes. -->
    <groupId>za.co.rmb.credit</groupId>
    <artifactId>daf-legacy-libs</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>DAF legacy libraries (jakarta)</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <transformer.version>1.0.0</transformer.version>
    </properties>

    <!-- Internal Nexus Repositories - No external internet access required -->
    <repositories>
        <repository>
            <id>rmb-nexus</id>
            <name>RMB Nexus Repository</name>
            <url>https://crsk-nexus.rmb.co.za/repository/maven-public/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>rmb-nexus-plugins</id>
            <name>RMB Nexus Plugin Repository</name>
            <url>https://crsk-nexus.rmb.co.za/repository/maven-public/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.transformer</groupId>
                <artifactId>transformer-maven-plugin</artifactId>
                <version>${transformer.version}</version>
                <configuration>
                    <rules>
                        <jakartaDefaults>true</jakartaDefaults>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>counterparty-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>counterparty-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>counterparty-client</artifactId><version>2.7.1cd</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>application-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>application-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>application-client</artifactId><version>2.6.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>facility-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>facility-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>facility-client</artifactId><version>2.5.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>referencedata-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>referencedata-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>referencedata-client</artifactId><version>2.5.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>rest-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>rest-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>rest-client</artifactId><version>2.4.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docstash-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>docstash-client</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>docstash-client</artifactId><version>1.0.2</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docstash-rest-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>docstash-rest-client</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>docstash-rest-client</artifactId><version>1.0.1</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>authservice-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>authservice-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>authservice-client</artifactId><version>1.1.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mailservice-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>mailservice-client</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>mailservice-client</artifactId><version>1.0.3</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>listmanagement-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>listmanagement-client</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>listmanagement-client</artifactId><version>1.0.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>listmanagement-rest-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>listmanagement-rest-client</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>listmanagement-rest-client</artifactId><version>1.0.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <!-- DAF rules client and model, built from reviewmandates (approvalforumrules) -->
                    <execution>
                        <id>approvalforumrules-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>approvalforumrules-model</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>approvalforumrules-model</artifactId><version>1.0.0-SNAPSHOT</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>approvalforumrules-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>approvalforumrules-client</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>approvalforumrules-client</artifactId><version>1.0.0-SNAPSHOT</version><type>jar</type></artifact>
                            <rules>
                                <renames>
                                    <rename>rules-client-renames.properties</rename>
                                </renames>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>approvalforumrules-rest-client</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>approvalforumrules-rest-client</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>approvalforumrules-rest-client</artifactId><version>1.0.0-SNAPSHOT</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <!-- Runtime of the JAXB "copyable" code generated into the model classes -->
                    <execution>
                        <id>jaxb2-basics-runtime</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>jaxb2-basics-runtime</classifier>
                            <artifact><groupId>org.jvnet.jaxb2_commons</groupId><artifactId>jaxb2-basics-runtime</artifactId><version>1.11.1</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <!-- Models -->
                    <execution>
                        <id>approvalforum-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>approvalforum-model</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>approvalforum-model</artifactId><version>1.0.2</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>authservice-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>authservice-model</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>authservice-model</artifactId><version>1.1.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mailservice-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>mailservice-model</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>mailservice-model</artifactId><version>1.0.3</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>referencedata-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>referencedata-model</classifier>
                            <artifact><groupId>za.co.rmb.credit</groupId><artifactId>referencedata-model</artifactId><version>2.5.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docstash-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>docstash-model</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>docstash-model</artifactId><version>1.0.1</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docstashrules-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>docstashrules-model</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>docstashrules-model</artifactId><version>1.1.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                    <execution>
                        <id>listmanagement-model</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>listmanagement-model</classifier>
                            <artifact><groupId>za.co.rmb</groupId><artifactId>listmanagement-model</artifactId><version>1.0.0</version><type>jar</type></artifact>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
