<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>za.co.rmb.credit</groupId>
    <artifactId>daf-boot-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DAF Boot</name>
    <description>Delegated Authority Forum backend (Java 25 / Spring Boot 4). The UI is the Credit platform DAF remote.</description>

    <modules>
        <module>legacy-libs</module>
        <module>support</module>
        <module>api</module>
        <module>rules</module>
        <module>docgen</module>
        <module>soap</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-boot.version>4.0.3</spring-boot.version>
    </properties>

    <!-- Internal Nexus Repositories - No external internet access required -->
    <repositories>
        <repository>
            <id>rmb-nexus</id>
            <name>RMB Nexus Repository</name>
            <url>https://crsk-nexus.rmb.co.za/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>rmb-nexus-plugins</id>
            <name>RMB Nexus Plugin Repository</name>
            <url>https://crsk-nexus.rmb.co.za/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
